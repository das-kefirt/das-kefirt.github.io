---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import site from '../data/site.json';
import { articles } from '../lib/articles.mjs';
import { sections } from '../lib/content.mjs';
---
<Base>
  <div class="wrap">
    <section class="masthead" aria-labelledby="masthead-title">
      <div class="masthead-kicker"><span class="eyebrow">Философский ресурс</span><a href={site.telegram}>Telegram ↗</a></div>
      <h1 id="masthead-title">das kefirt<span class="period">.</span></h1>
      <div class="masthead-bottom"><p>{site.intro}</p></div>
    </section>
    {articles.length ? <section class="home-latest"><div class="section-heading"><h2>Последние публикации</h2><a href="/archive/">Весь архив ↗</a></div><ArticleList articles={articles.slice(0, 5)} /></section> :
    <section class="opening-note">
      <div class="opening-side"><span class="opening-symbol" aria-hidden="true">*</span></div>
      <div class="opening-main"><h2>Первые<br /><em>публикации.</em></h2><p>Скоро на сайте.</p><a class="text-link" href="/about/">О проекте <span aria-hidden="true">↗</span></a></div>
      <aside class="opening-aside"><span class="eyebrow">Telegram</span><a href={site.telegram} class="text-link">@daskefirt ↗</a><div class="small-rule"></div><a href="/preview/" class="sample-link">Образец статьи <span aria-hidden="true">→</span></a></aside>
    </section>}
    <section class="section-directory" aria-labelledby="sections-title"><div class="section-heading"><h2 id="sections-title">Разделы</h2></div>
      {[...sections, { slug: 'friends', label: 'Друзья', description: 'Каналы и проекты друзей.' }].map((item, i) => <a class="directory-row" href={`/${item.slug}/`}><span class="directory-index">0{i + 1}</span><h3>{item.label}</h3><p>{item.description}</p><span class="directory-arrow" aria-hidden="true">↗</span></a>)}
    </section>
  </div>
</Base>
