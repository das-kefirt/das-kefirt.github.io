---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { articles } from '../lib/articles.mjs';
import { sections } from '../lib/content.mjs';
export function getStaticPaths() { return sections.map(section => ({ params: { section: section.slug }, props: { section } })); }
const { section } = Astro.props;
const items = articles.filter(a => a.section === section.slug);
---
<Base title={section.label} description={section.description}><div class="wrap page-section"><header class="page-heading"><h1>{section.label}<span class="period">.</span></h1><p>{section.description}</p></header><ArticleList articles={items} /></div></Base>
