---
import Base from '../layouts/Base.astro';
---
<Base title="Страница не найдена" noindex><div class="wrap page-section"><header class="page-heading"><span class="eyebrow">404</span><h1>Страница<br /><em>не найдена.</em></h1><p>Возможно, адрес изменился или в ссылке появилась опечатка.</p></header><a class="text-link" href="/">Вернуться на главную →</a><p id="old-draft" hidden><button type="button" class="text-link">Скачать прежний черновик ↓</button></p></div>
<script>
  // Migration on the original storage origin, visible only to a browser with an old draft.
  if (/^\/editor(?:\/index\.html|\/)?$/.test(location.pathname)) {
    try {
      const saved = JSON.parse(localStorage.getItem('das-kefirt-editor-draft-v1') || 'null');
      if (saved?.article && typeof saved.article.body === 'string') {
        const box = document.getElementById('old-draft');
        box.hidden = false;
        box.querySelector('button').onclick = () => {
          const {body, ...meta} = saved.article;
          const data = {...meta, _editor:saved.origin || undefined, _cover:saved.coverAsset || undefined, published:false};
          const blob = new Blob(['---\n',JSON.stringify(data,null,2),'\n---\n\n',body,'\n'],{type:'text/markdown;charset=utf-8'});
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob); a.download = 'das-kefirt-draft.md'; a.click();
          setTimeout(() => URL.revokeObjectURL(a.href), 10000);
        };
      }
    } catch { /* No accessible local draft. */ }
  }
</script></Base>
