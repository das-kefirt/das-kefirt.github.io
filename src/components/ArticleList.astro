---
import { sections } from '../lib/content.mjs';
import { formatDate } from '../lib/articles.mjs';
const { articles, empty = 'Первые публикации появятся здесь.' } = Astro.props;
---
{articles.length ? <div class="article-list">{articles.map(item => <article class="article-row">
  <div class="article-row-meta"><span class="eyebrow">{sections.find(s => s.slug === item.section)?.singular}</span><span>{item.author}</span></div>
  <div><h2><a href={`/read/${item.slug}/`}>{item.title}</a></h2><p>{item.description}</p><div class="tags">{item.tags.map(tag => <span>{tag}</span>)}</div></div>
  <time datetime={new Date(item.date).toISOString()}>{formatDate(item.date)}</time>
</article>)}</div> : <div class="empty-state"><span class="empty-line" aria-hidden="true"></span><p>{empty}</p><a class="text-link" href="https://t.me/daskefirt">Пока читаем в Telegram ↗</a></div>}
