---
import site from '../data/site.json';
import '../styles/global.css';
import '@fontsource/manrope/cyrillic-400.css';
import '@fontsource/manrope/cyrillic-600.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/pt-serif/cyrillic-400.css';
import '@fontsource/pt-serif/cyrillic-400-italic.css';
import '@fontsource/pt-serif/cyrillic-700.css';
import '@fontsource/pt-serif/latin-400.css';
import '@fontsource/pt-serif/latin-400-italic.css';
import '@fontsource/pt-serif/latin-700.css';
const { title = site.title, description = site.description, noindex = false, article = false } = Astro.props;
const pageTitle = title === site.title ? `${title} — философский ресурс` : `${title} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [{ href: '/translations/', label: 'Переводы' }, { href: '/essays/', label: 'Тексты' }, { href: '/columns/', label: 'Колонки' }, { href: '/friends/', label: 'Друзья' }];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ef" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="das kefirt" />
    <meta property="og:image" content={new URL('/images/logo.png', Astro.site).href} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="alternate" type="application/rss+xml" title="das kefirt — новые публикации" href="/rss.xml" />
    <script is:inline>
      try { const t = localStorage.getItem('kefirt-theme'); if (t === 'dark') document.documentElement.dataset.theme = 'dark'; } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">К содержимому</a>
    <header class="site-header wrap" data-pagefind-ignore>
      <a href="/" class="brand" aria-label="das kefirt — главная">
        <img src="/images/logo.png" width="44" height="44" alt="" />
        <span>das kefirt</span>
      </a>
      <nav aria-label="Основные разделы" class="main-nav">
        {nav.map(item => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <div class="header-tools">
        <a href="/search/" class="search-link" aria-label="Поиск по сайту"><span class="search-icon" aria-hidden="true"></span><span class="search-word">Поиск</span></a>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Переключить тему" aria-pressed="false"><span aria-hidden="true">◐</span></button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap" data-pagefind-ignore>
      <div class="footer-top"><a class="footer-brand" href="/">das kefirt<span>.</span></a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} das kefirt</span><nav aria-label="О проекте"><a href="/about/">О проекте</a><a href="/authors/">Авторы</a><a href={site.telegram}>Telegram ↗</a><a href="/rss.xml">RSS</a><a href="/editor/" rel="nofollow">Редактор</a></nav><a href="#main">Наверх ↑</a></div>
    </footer>
    <script>
      const toggle = document.getElementById('theme-toggle');
      const sync = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        toggle?.setAttribute('aria-pressed', String(dark));
        toggle?.setAttribute('aria-label', dark ? 'Включить светлую тему' : 'Включить тёмную тему');
      };
      sync();
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('kefirt-theme', next); } catch {}
        sync();
      });
    </script>
  </body>
</html>
